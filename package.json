{
  "name": "adgen-saas",
  "version": "0.1.0",
  "private": true,
  "description": "AI video/image ad-generator SaaS for Balkan COD e-commerce",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/sync-env.mjs",
    "env:sync": "node scripts/sync-env.mjs",
    "dev": "pnpm -r --parallel --stream run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:seed": "pnpm --filter @adgen/db run seed",
    "supabase": "supabase",
    "services:up": "docker compose -f infra/docker-compose.yml up -d",
    "services:down": "docker compose -f infra/docker-compose.yml down",
    "services:logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "ffmpeg-static",
      "ffprobe-static",
      "msgpackr-extract",
      "sharp",
      "unrs-resolver",
      "youtube-dl-exec"
    ]
  }
}
