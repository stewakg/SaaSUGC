# dependencies
node_modules/
.pnpm-store/

# next.js
.next/
out/
build/
dist/

# env files (keep .env.example)
.env
.env.local
.env.*.local
apps/*/.env
apps/*/.env.local
packages/*/.env

# supabase
supabase/.branches
supabase/.temp

# local storage of generated assets
# Root-anchored on purpose: a bare `storage/` matches a directory named
# `storage` at ANY depth, which silently swallowed the whole
# apps/web/src/app/api/storage/ route — it was never committed (found
# 2026-08-05). Keep the leading slash.
/storage/
apps/web/public/generated/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# os
.DS_Store
Thumbs.db

# editor
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# claude code — personal/local settings, not shared config
.claude/settings.local.json

# typescript
*.tsbuildinfo

# testing
coverage/

# remotion bundle output
remotion/out/
remotion/.rodo/

# local video test samples for Matrix scene-detection (not shared)
Video samples/