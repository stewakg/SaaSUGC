# =============================================================================
# Root .env.example — copy to .env (and per-app .env) and fill in as you go.
# In dev EVERYTHING is optional: missing keys => the app uses the MOCK provider.
# Real keys are only required from Phase F5 onward (see ACCOUNTS.md).
# Never commit real values.
# =============================================================================

# --- Supabase (DB + Auth) ---
# Local dev uses `supabase start` defaults; cloud values come from F5.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY= # worker only, server-only — NEVER in the browser bundle
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Redis (worker queue, BullMQ) ---
REDIS_URL=

# --- AI providers ---
ANTHROPIC_API_KEY=    # Claude Opus — ad scripts
KIE_API_KEY=          # kie.ai primary AI aggregator
FAL_API_KEY=          # fal.ai fallback AI aggregator
ELEVENLABS_API_KEY=   # ElevenLabs TTS

# --- Storage (Cloudflare R2 or AWS S3) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=          # custom domain or the R2.dev subdomain, enabled from the Cloudflare dashboard
# (or) AWS_ACCESS_KEY_ID= AWS_SECRET_ACCESS_KEY= AWS_REGION= AWS_S3_BUCKET= AWS_S3_PUBLIC_URL=

# --- Remotion Lambda (prod render) ---
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_SERVE_URL=
REMOTION_AWS_REGION=    # defaults to eu-central-1 if unset

# --- Billing (F6, needs USt-IdNr) ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_MAP=  # JSON: pack id -> Lemon Squeezy variant id, e.g. {"pack_starter":"123456"}

# --- App ---
# Node env; set explicitly per app. NODE_ENV=development by default in `pnpm dev`.