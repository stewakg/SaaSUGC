# =============================================================================
# Root .env.example — copy to .env (and per-app .env) and fill in as you go.
# In dev EVERYTHING is optional: missing keys => the app uses the MOCK provider.
# Real keys are only required from Phase F5 onward (see ACCOUNTS.md).
# Never commit real values.
# =============================================================================

# --- Supabase (DB + Auth) ---
# Local dev uses `supabase start` defaults; cloud values come from F5.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY= # worker only, server-only — NEVER in the browser bundle
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Redis (worker queue, BullMQ) ---
REDIS_URL=

# --- AI providers ---
OPENROUTER_API_KEY=       # ad scripts (and later vision) — one key, many models
OPENROUTER_SCRIPT_MODEL=  # optional override; unset = the provider's default
KIE_API_KEY=          # kie.ai primary AI aggregator
FAL_API_KEY=          # fal.ai fallback AI aggregator
ELEVENLABS_API_KEY=   # ElevenLabs TTS

# --- Storage (Cloudflare R2 or AWS S3) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=          # custom domain or the R2.dev subdomain, enabled from the Cloudflare dashboard
# S3 endpoint, copied VERBATIM from the Cloudflare dashboard. Cloudflare serves a
# different one per bucket jurisdiction — an EU bucket is
# https://<account>.eu.r2.cloudflarestorage.com and the default form fails against
# it with "bucket not found". This project's bucket is EU. Leave empty only for a
# default-jurisdiction bucket.
R2_ENDPOINT=
# (or) AWS_ACCESS_KEY_ID= AWS_SECRET_ACCESS_KEY= AWS_REGION= AWS_S3_BUCKET= AWS_S3_PUBLIC_URL=

# --- Remotion Lambda (prod render) ---
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_SERVE_URL=
REMOTION_AWS_REGION=    # defaults to eu-central-1 if unset

# --- Billing: ASLEEP since 2026-08-16 ---
# The operator is a Wyoming LLC, which removed the merchant-of-record reason
# Lemon Squeezy was chosen for; Stripe goes in once the company is confirmed.
# The code is kept (this layer was already deleted once and restored three days
# later) but it will NOT wake on keys alone: leave BILLING_PROVIDER unset and
# billing stays mocked, which in production means checkout answers 503 rather
# than handing out free credits.
BILLING_PROVIDER=        # empty = no payment provider. Only value today: lemonsqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# JSON object mapping each CREDIT_PACKS id to its Lemon Squeezy variant id:
# {"pack_starter":"123456","pack_creator":"123457"}
LEMONSQUEEZY_VARIANT_MAP=

# --- Admin ---
# Comma-separated emails that keep the instant-credit button in PRODUCTION.
# Outside production every signed-in user has it, so this only matters live.
# An admin can mint credits for free — keep the list to accounts that need it,
# and never add a customer "temporarily". Deliberately an env var and not a
# constant in the source: this repo is public, and an email in it is published.
ADMIN_EMAILS=

# --- App ---
# Node env; set explicitly per app. NODE_ENV=development by default in `pnpm dev`.
# --- Worker ---
# Jobs run at once. Default 4. Set 1 or 2 on the box that renders video:
# one Remotion render already saturates every core and wants ~2GB.
WORKER_CONCURRENCY=
# Optional: POST a one-line message here whenever a job fails (Discord/Slack/Telegram relay).
# Unset = no alerts, which is the right default for a dev machine.
ALERT_WEBHOOK_URL=
