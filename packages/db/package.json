{
  "name": "@adgen/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/generated/database.types.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed.ts",
    "gen-types": "supabase gen types typescript --local > src/generated/database.types.ts"
  },
  "dependencies": {
    "@adgen/core": "workspace:*",
    "@supabase/supabase-js": "^2.45.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}